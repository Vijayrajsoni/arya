<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact Us | Arya Agricultural</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f4f9f4;
}

/* Header */
.hero{
    background:linear-gradient(rgba(0,100,0,.75),rgba(0,100,0,.75)),
    url("https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=1500&q=80");
    background-size:cover;
    background-position:center;
    height:280px;
    display:flex;
    justify-content:center;
    align-items:center;
    color:white;
    text-align:center;
}

.hero h1{
    font-size:48px;
}

.hero p{
    margin-top:10px;
    font-size:18px;
}

/* Container */

.container{
    width:90%;
    max-width:1200px;
    margin:50px auto;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
}

/* Contact Info */

.info{
    background:white;
    border-radius:15px;
    padding:35px;
    box-shadow:0 10px 25px rgba(0,0,0,.1);
}

.info h2{
    color:#2e7d32;
    margin-bottom:25px;
}

.box{
    display:flex;
    align-items:center;
    margin-bottom:25px;
}

.icon{
    width:60px;
    height:60px;
    border-radius:50%;
    background:#2e7d32;
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:25px;
    margin-right:20px;
}

.box h3{
    color:#333;
}

.box p{
    color:#666;
}

/* Form */

.form{
    background:white;
    border-radius:15px;
    padding:35px;
    box-shadow:0 10px 25px rgba(0,0,0,.1);
}

.form h2{
    color:#2e7d32;
    margin-bottom:20px;
}

.form input,
.form textarea{
    width:100%;
    padding:15px;
    margin-bottom:18px;
    border:1px solid #ccc;
    border-radius:8px;
    outline:none;
    font-size:15px;
}

.form input:focus,
.form textarea:focus{
    border-color:#2e7d32;
}

.form textarea{
    resize:none;
    height:140px;
}

.form button{
    width:100%;
    padding:15px;
    border:none;
    border-radius:8px;
    background:#2e7d32;
    color:white;
    font-size:18px;
    cursor:pointer;
    transition:.3s;
}

.form button:hover{
    background:#1b5e20;
}

/* Map */

.map{
    width:90%;
    max-width:1200px;
    margin:40px auto;
}

.map iframe{
    width:100%;
    height:400px;
    border:none;
    border-radius:15px;
    box-shadow:0 8px 20px rgba(0,0,0,.15);
}

/* Footer */

footer{
    background:#1b5e20;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:40px;
}

@media(max-width:768px){

.container{
    grid-template-columns:1fr;
}

.hero h1{
    font-size:35px;
}

}

</style>

</head>
<body>

<%- include("header") %>

<section class="hero">

<div>

<h1>Contact Arya Agricultural</h1>

<p>We're here to help farmers grow better every day.</p>

</div>

</section>

<div class="container">

<div class="info">

<h2>Contact Information</h2>

<div class="box">

<div class="icon">📍</div>

<div>

<h3>Address</h3>

<p>Prayagraj, Uttar Pradesh, India</p>

</div>

</div>

<div class="box">

<div class="icon">📞</div>

<div>

<h3>Phone</h3>

<p>+91 9876543210</p>

</div>

</div>

<div class="box">

<div class="icon">✉️</div>

<div>

<h3>Email</h3>

<p>info@aryaagricultural.com</p>

</div>

</div>

<div class="box">

<div class="icon">🕒</div>

<div>

<h3>Working Hours</h3>

<p>Monday - Saturday<br>9:00 AM - 6:00 PM</p>

</div>

</div>

</div>

<div class="form">

<h2>Send Us a Message</h2>

<form action="/contacts" method="POST">

<input type="text" name="name" placeholder="Your Name" required>

<input type="email" name="email" placeholder="Your Email" required>

<input type="text" name="subject" placeholder="Subject" required>

<textarea name="message" placeholder="Write your message..." required></textarea>

<button type="submit">Send Message</button>

</form>

</div>

</div>



<footer>
<%- include("footer") %>

</footer>

</body>
</html>