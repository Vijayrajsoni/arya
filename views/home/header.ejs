<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Arya Agricultural</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f5f8f1;
        }

        /* ================= HEADER ================= */

        header {
            width: 100%;
            background: linear-gradient(90deg, #1b5e20, #2e7d32, #43a047);
            color: white;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.2);
        }

        .navbar {
            width: 92%;
            max-width: 1400px;
            min-height: 80px;
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* ================= LOGO ================= */

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
        }

        .logo img {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid white;
            background: white;
        }

        .logo h2 {
            font-size: 25px;
            color: white;
            white-space: nowrap;
        }

        .logo h2 span {
            color: #ffd54f;
        }

        /* ================= NAVIGATION ================= */

        nav ul {
            display: flex;
            align-items: center;
            gap: 8px;
            list-style: none;
        }

        nav ul li {
            list-style: none;
        }

        nav ul li a {
            display: block;

            color: white;
            text-decoration: none;

            font-size: 15px;
            font-weight: 600;

            padding: 9px 10px;
            border-radius: 8px;

            transition: 0.3s;
        }

        nav ul li a:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #ffeb3b;
        }

        /* ================= USER BUTTON ================= */

        .login-btn {
            display: flex;
            align-items: center;
            margin-left: 10px;
        }

        .login-btn a {
            display: flex;
            align-items: center;

            background: #ffeb3b;
            color: #1b5e20;

            padding: 10px 15px;
            border-radius: 30px;

            text-decoration: none;
            font-weight: bold;

            white-space: nowrap;

            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);

            transition: 0.3s;
        }

        .login-btn a:hover {
            background: white;
            transform: translateY(-2px);
        }

        .login-btn span {
            color: #1b5e20;
            font-size: 14px;
            font-weight: 700;
        }

        /* ================= HAMBURGER ================= */

        .menu-toggle {
            display: none;

            background: transparent;
            border: none;

            color: white;
            font-size: 32px;

            cursor: pointer;

            padding: 5px;
        }

        /* ================================================= */
        /* ================= TABLET ======================== */
        /* ================================================= */

        @media (max-width: 1200px) {

            .navbar {
                width: 94%;
            }

            .logo h2 {
                font-size: 22px;
            }

            nav ul {
                gap: 2px;
            }

            nav ul li a {
                font-size: 14px;
                padding: 8px 7px;
            }

            .login-btn a {
                padding: 9px 12px;
            }
        }


        /* ================================================= */
        /* ================= MOBILE ======================== */
        /* ================================================= */

        @media (max-width: 900px) {

            .navbar {
                min-height: 70px;
                position: relative;
            }

            /* LOGO */

            .logo img {
                width: 50px;
                height: 50px;
            }

            .logo h2 {
                font-size: 20px;
            }

            /* HAMBURGER */

            .menu-toggle {
                display: block;
                margin-left: auto;
            }

            /* NAVIGATION */

            nav {
                display: none;

                position: absolute;

                top: 70px;
                left: 0;

                width: 100%;

                background: #1b5e20;

                padding: 15px;

                box-shadow: 0 5px 12px rgba(0, 0, 0, 0.25);
            }

            /* JS SE OPEN HOGA */

            nav.active {
                display: block;
            }

            nav ul {
                flex-direction: column;
                align-items: stretch;

                width: 100%;
                gap: 5px;
            }

            nav ul li {
                width: 100%;
            }

            nav ul li a {
                width: 100%;
                text-align: center;

                padding: 12px;

                font-size: 16px;
            }

            nav ul li a:hover {
                background: #2e7d32;
            }

            /* LOGIN BUTTON */

            .login-btn {
                display: none;
            }
        }


        /* ================================================= */
        /* ================= SMALL MOBILE ================= */
        /* ================================================= */

        @media (max-width: 500px) {

            .navbar {
                width: 94%;
                min-height: 65px;
            }

            .logo {
                gap: 7px;
            }

            .logo img {
                width: 45px;
                height: 45px;
            }

            .logo h2 {
                font-size: 17px;
            }

            .menu-toggle {
                font-size: 28px;
            }

            nav {
                top: 65px;
            }
        }


        /* ================================================= */
        /* ================= VERY SMALL ==================== */
        /* ================================================= */

        @media (max-width: 350px) {

            .logo h2 {
                font-size: 15px;
            }

            .logo img {
                width: 40px;
                height: 40px;
            }

            .menu-toggle {
                font-size: 25px;
            }
        }

    </style>
</head>


<body>

<header>

    <div class="navbar">

        <!-- ================= LOGO ================= -->

        <div class="logo">

            <img
                src="/image/Untitled - June 30, 2026 at 23.01.56 (1).png"
                alt="Arya Agricultural Logo"
            >

            <h2>
                Arya <span>Agricultural</span>
            </h2>

        </div>


        <!-- ================= HAMBURGER ================= -->

        <button
            class="menu-toggle"
            id="menuToggle"
            aria-label="Open Menu"
        >
            ☰
        </button>


        <!-- ================= NAVIGATION ================= -->

        <nav id="mobileNav">

            <ul>

                <li>
                    <a href="/home">🏠 Home</a>
                </li>

                <li>
                    <a href="/about">ℹ️ About</a>
                </li>

                <li>
                    <a href="/product">🌾 Products</a>
                </li>

                <li>
                    <a href="/services">🚜 Services</a>
                </li>

                <li>
                    <a href="/news">📰 News</a>
                </li>

                <li>
                    <a href="/cart">🛒 Cart</a>
                </li>

                <li>
                    <a href="/contact">📞 Contact</a>
                </li>

                <li>
                    <a href="/login">🔓 Logout</a>
                </li>

            </ul>

        </nav>


        <!-- ================= USER ================= -->

        <div class="login-btn">

            <% if (user) { %>

                <a href="#">
                    <span>
                        👤 Welcome, <%= user.name %>
                    </span>
                </a>

            <% } else { %>

                <a href="/login">
                    👤 Login
                </a>

            <% } %>

        </div>

    </div>

</header>


<!-- ================= MOBILE MENU JS ================= -->

<script>

    const menuToggle = document.getElementById("menuToggle");
    const mobileNav = document.getElementById("mobileNav");

    menuToggle.addEventListener("click", function () {

        mobileNav.classList.toggle("active");

        if (mobileNav.classList.contains("active")) {

            menuToggle.innerHTML = "✕";
            menuToggle.setAttribute("aria-label", "Close Menu");

        } else {

            menuToggle.innerHTML = "☰";
            menuToggle.setAttribute("aria-label", "Open Menu");

        }

    });


    /* Menu link click hone ke baad menu close */

    document.querySelectorAll("#mobileNav a").forEach(function (link) {

        link.addEventListener("click", function () {

            mobileNav.classList.remove("active");

            menuToggle.innerHTML = "☰";

        });

    });

</script>

</body>

