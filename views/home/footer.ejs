</form>

</div>

<!-- Google Map -->

<div class="map">

<iframe
src="https://www.google.com/maps?q=Prayagraj&output=embed"
loading="lazy">
</iframe>

</div>

<!-- Bottom Footer -->

<div class="bottom-footer">

<p>

