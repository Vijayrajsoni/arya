<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<style>
    .footer{

background:#0d3b17;
color:white;
margin-top:80px;

}

.footer-container{

width:90%;
max-width:1300px;
margin:auto;
padding:60px 0;

display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:40px;

}

.footer-box h2{

color:#ffd54f;
margin-bottom:20px;

}

.footer-box h3{

margin-bottom:20px;
color:#90ee90;

}

.footer-box p{

line-height:1.8;
color:#ddd;

}

.footer-box ul{

list-style:none;

}

.footer-box ul li{

margin:12px 0;

}

.footer-box ul li a{

text-decoration:none;
color:#ddd;
transition:.3s;

}

.footer-box ul li a:hover{

color:#ffd54f;
padding-left:8px;

}

/* Social */

.social{

margin-top:20px;

}

.social a{

display:inline-flex;
justify-content:center;
align-items:center;

width:45px;
height:45px;

margin-right:10px;

background:#1b5e20;

color:white;

border-radius:50%;

font-size:18px;

transition:.4s;

text-decoration:none;

}

.social a:hover{

background:#ffd54f;
color:#1b5e20;
transform:translateY(-6px);

}

/* Newsletter */

.newsletter{

background:#1b5e20;

padding:50px 20px;

text-align:center;

}

.newsletter h2{

margin-bottom:15px;

}

.newsletter p{

margin-bottom:25px;

color:#ddd;

}

.newsletter form{

display:flex;

justify-content:center;

flex-wrap:wrap;

gap:15px;

}

.newsletter input{

width:400px;

padding:15px;

border:none;

border-radius:50px;

outline:none;

font-size:16px;

}

.newsletter button{

padding:15px 35px;

border:none;

border-radius:50px;

background:#ffd54f;

font-size:16px;

font-weight:bold;

cursor:pointer;

transition:.3s;

}

.newsletter button:hover{

background:white;

}

/* Map */

.map{

width:100%;

}

.map iframe{

width:100%;

height:300px;

border:none;

}

/* Bottom */

.bottom-footer{

background:#07270f;

padding:20px;

display:flex;

justify-content:space-between;

flex-wrap:wrap;

text-align:center;

}

.bottom-footer p{

color:#ccc;

}

/* Responsive */

@media(max-width:768px){

.bottom-footer{

flex-direction:column;

gap:10px;

}

.newsletter input{

width:100%;

}


}
</style>
<body>
    <footer class="footer">

<div class="footer-container">

<!-- Company -->

<div class="footer-box">

<h2>🌾 Arya Agricultural</h2>

<p>
Arya Agricultural is dedicated to empowering farmers through modern
technology, premium seeds, fertilizers, smart irrigation systems,
and sustainable farming solutions.
</p>

