<a href="#"><i class="fab fa-x-twitter"></i></a>

<a href="#"><i class="fab fa-youtube"></i></a>

<a href="#"><i class="fab fa-linkedin-in"></i></a>

</div>

</div>

<!-- Quick Links -->

<div class="footer-box">

<h3>Quick Links</h3>

<ul>

<li><a href="/">🏠 Home</a></li>

<li><a href="/about">ℹ About</a></li>

<li><a href="/product">🌱 Products</a></li>

<li><a href="/services">🚜 Services</a></li>

<li><a href="/news">📰 News</a></li>

<li><a href="/contact">📞 Contact</a></li>

</ul>

</div>

<!-- Services -->

<div class="footer-box">

<h3>Our Services</h3>

<ul>

<li>🌾 Premium Seeds</li>

<li>🌿 Organic Fertilizer</li>

<li>💧 Smart Irrigation</li>

<li>🚜 Farm Machinery</li>

<li>👨‍🌾 Expert Consultation</li>

<li>📦 Home Delivery</li>

</ul>

</div>

<!-- Contact -->

<div class="footer-box">

<h3>Contact Us</h3>

<p>📍 Prayagraj, Uttar Pradesh, India</p>

<p>📞 +91 9876543210</p>

<p>✉ info@aryaagricultural.com</p>

<p>🕒 Mon - Sat : 9 AM - 6 PM</p>

</div>

</div>

<!-- Newsletter -->


<div class="newsletter">

<h2>Subscribe to Our Newsletter</h2>

<p>

Get the latest agriculture news, weather updates,
government schemes and farming tips.

</p>

<form action="/newsletter" method="post">

