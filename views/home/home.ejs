<%- include("header") %>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Arya Agricultural</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#f5f9f3;
}

/* Hero */

.hero{
height:90vh;
background:linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.55)),
url("/image/1eb40e8f6c568d75f45bcb41ad97bdf9.gif") center/cover;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
color:white;
}

.hero h1{
font-size:65px;
margin-bottom:20px;
}

.hero span{
color:#ffd54f;
}

.hero p{
font-size:22px;
width:70%;
margin:auto;
line-height:1.8;
}

.btns{
margin-top:35px;
}

.btn{
display:inline-block;
padding:15px 35px;
margin:10px;
border-radius:35px;
text-decoration:none;
font-size:18px;
font-weight:bold;
transition:.4s;
}

.btn1{
background:#2e7d32;
color:white;
}

.btn1:hover{
background:#1b5e20;
}

.btn2{
background:#ffd54f;
color:#1b5e20;
}

.btn2:hover{
background:white;
}

/* About */

.about{
width:90%;
max-width:1200px;
margin:80px auto;
display:grid;
grid-template-columns:1fr 1fr;
gap:50px;
align-items:center;
}

.about img{
width:100%;
border-radius:20px;
}

.about h2{
font-size:40px;
color:#2e7d32;
margin-bottom:20px;
}

.about p{
line-height:1.9;
color:#555;
font-size:18px;
}

/* Services */

.services{
padding:80px 8%;
background:white;
}

.title{
text-align:center;
font-size:42px;
color:#2e7d32;
margin-bottom:50px;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:30px;
}

.card{
background:#f7fff7;
padding:35px;
border-radius:18px;
text-align:center;
box-shadow:0 5px 15px rgba(0,0,0,.1);
transition:.4s;
}

.card:hover{
transform:translateY(-10px);
}

.card h3{
margin:20px 0;
color:#2e7d32;
}

.icon{
font-size:55px;
}

/* Products */

.products{
padding:80px 8%;
}

.product-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(270px,1fr));
gap:30px;
}

.product{
background:white;
border-radius:18px;
overflow:hidden;
box-shadow:0 5px 15px rgba(0,0,0,.15);
}

.product img{
width:100%;
height:220px;
object-fit:cover;
}

.product h3{
padding:15px;
color:#2e7d32;
}

.product p{
padding:0 15px 20px;
color:#666;
}

/* Counter */

.counter{
background:#2e7d32;
padding:70px;
color:white;
}

.counter-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
text-align:center;
gap:30px;
}

.counter h2{
font-size:50px;
}

.counter p{
font-size:20px;
}

/* Video */

.video{
padding:80px;
text-align:center;
}

.video h2{
font-size:42px;
color:#2e7d32;
margin-bottom:30px;
}

.video iframe{
width:90%;
max-width:900px;
height:500px;
border:none;
border-radius:20px;
box-shadow:0 10px 30px rgba(0,0,0,.2);
}

/* Testimonials */

.testimonial{
background:white;
padding:80px;
}

.review-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
gap:30px;
}

.review{
padding:30px;
background:#f5f9f3;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,.1);
}

.review h4{
margin-top:20px;
color:#2e7d32;
}

/* CTA */

.cta{
background:linear-gradient(135deg,#2e7d32,#1b5e20);
padding:70px;
text-align:center;
color:white;
}

.cta h2{
font-size:42px;
margin-bottom:20px;
}

.cta a{
display:inline-block;
margin-top:20px;
padding:15px 35px;
background:white;
color:#2e7d32;
text-decoration:none;
border-radius:30px;
font-weight:bold;
}

/* Footer */

footer{
background:#1b5e20;
color:white;
padding:20px;
text-align:center;
}

/* Responsive */

@media(max-width:768px){

.hero h1{
font-size:38px;
}

.hero p{
width:95%;
font-size:17px;
}

.about{
grid-template-columns:1fr;
}

.video iframe{
height:250px;
}

}

</style>

</head>

<body>

