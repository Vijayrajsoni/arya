<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Modern Login Form</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:
    linear-gradient(rgba(34,139,34,0.55),rgba(0,100,0,0.55)),
    url("https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=1600&q=80");
    background-size:cover;
    background-position:center;
    overflow:hidden;
}

.login-box{
    width:400px;
    background:rgba(255,255,255,0.15);
    backdrop-filter:blur(15px);
    -webkit-backdrop-filter:blur(15px);
    border:1px solid rgba(255,255,255,0.3);
    border-radius:20px;
    padding:40px 35px;
    box-shadow:0 15px 35px rgba(0,0,0,.35);
    animation:fadeIn .8s ease;
}

.login-box h2{
    color:#fff;
    text-align:center;
    margin-bottom:30px;
    font-size:32px;
    letter-spacing:1px;
}

.input-box{
    margin-bottom:20px;
}

.input-box label{
    display:block;
    color:#fff;
    margin-bottom:8px;
    font-weight:bold;
}

.input-box input{
    width:100%;
    padding:14px 15px;
    border:none;
    outline:none;
    border-radius:10px;
    font-size:15px;
    background:rgba(255,255,255,.92);
    transition:.3s;
}

.input-box input:focus{
    background:#fff;
    box-shadow:0 0 10px rgba(76,175,80,.8);
}

.options{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
    color:#fff;
    font-size:14px;
}
.captcha-box{
    margin-top:15px;
}

.captcha-code{
    width:150px;
    background:#0d6efd;
    color:#fff;
    padding:10px;
    text-align:center;
    font-size:22px;
    font-weight:bold;
    letter-spacing:5px;
    border-radius:5px;
    margin-bottom:10px;
    user-select:none;
}

.options label{
    display:flex;
    align-items:center;
    gap:5px;
    cursor:pointer;
}

.options a{
    color:#fff;
    text-decoration:none;
}

.options a:hover{
    text-decoration:underline;
}
.captcha-box{
    margin-top:15px;
}

.captcha-code{
    width:150px;
    background:#0d6efd;
    color:#fff;
    padding:10px;
    text-align:center;
    font-size:22px;
    font-weight:bold;
    letter-spacing:5px;
    border-radius:5px;
    margin-bottom:10px;
    user-select:none;
}

.login-btn{
    width:100%;
    padding:14px;
    border:none;
    border-radius:10px;
    background:linear-gradient(135deg,#2e7d32,#66bb6a);
    color:#fff;
    font-size:18px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
}

.login-btn:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 20px rgba(0,0,0,.25);
}

.bottom-text{
    margin-top:20px;
    text-align:center;
    color:#fff;
    font-size:14px;
}

.bottom-text a{
    color:#fff;
    font-weight:bold;
    text-decoration:none;
}

.bottom-text a:hover{
    text-decoration:underline;
}

@keyframes fadeIn{
    from{
        opacity:0;
        transform:translateY(40px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

@media(max-width:500px){

.login-box{
    width:92%;
    padding:30px 20px;
}

.login-box h2{
    font-size:28px;
}

}
</style>
</head>

<body>

<div class="login-box">

<h2>Login Form</h2>

<form name="f1" method="post" action="/loginres">

<div class="input-box">
<label>User Name</label>
<input
type="text"
name="t1"
placeholder="Enter your username"
required>
</div>

<div class="input-box">
<label>Password</label>
<input
type="password"
name="t2"
placeholder="Enter your password"
required>
  
</div>




<div class="options">


<a href="/forgotpassword">Forgot Password?</a>
</div>

<input
type="submit"
value="Login"
name="b1"
class="login-btn">

<div class="bottom-text">
Don't have an account?
<a href="/register">Register</a>
</div>

</form>

</div>

</body>
</html>