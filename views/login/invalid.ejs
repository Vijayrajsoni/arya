<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invalid Page</title>

    <style>
        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body{
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
        }

        .error-box{
            width: 90%;
            max-width: 450px;
            background: #fff;
            padding: 40px 30px;
            text-align: center;
            border-radius: 20px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.25);
            animation: fadeIn 0.8s ease-in-out;
        }

        .error-icon{
            font-size: 70px;
            color: #ff4b2b;
            margin-bottom: 20px;
        }

        .error-box h1{
            font-size: 32px;
            color: #222;
            margin-bottom: 15px;
        }

        .error-box p{
            font-size: 18px;
            color: #555;
            margin-bottom: 25px;
            line-height: 1.6;
        }

        .btn{
            display: inline-block;
            text-decoration: none;
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: white;
            padding: 12px 25px;
            border-radius: 10px;
            font-size: 17px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover{
            transform: scale(1.05);
            box-shadow: 0 6px 18px rgba(0,0,0,0.2);
        }

        @keyframes fadeIn{
            from{
                opacity: 0;
                transform: translateY(-20px);
            }
            to{
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>

    <div class="error-box">
        <div class="error-icon">⚠️</div>
        <h1>Invalid Page</h1>
        <p>
            Sorry! The page you are trying to access is invalid, unavailable, or you are not authorized to view it.
        </p>
        <a href="/login" class="btn">Go Back Home</a>
    </div>

</body>
</html>